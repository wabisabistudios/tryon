{
  "name": "based-tryon",
  "version": "1.0.0",
  "private": true,
  "description": "Based Aesthetics — AI Nail Try-On. Cloudflare Worker API + no-build static page.",
  "scripts": {
    "dev": "wrangler dev --config worker/wrangler.toml --port 8787",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --port 8787",
    "dev:page": "serve public --listen 3000 --no-clipboard",
    "build:preview": "python3 scripts/build-preview.py"
  },
  "devDependencies": {
    "serve": "14.2.4",
    "wrangler": "4.131.1"
  }
}
